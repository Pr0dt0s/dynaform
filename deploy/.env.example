# Copy to deploy/.env and adjust to your own setup. Nothing here needs to be secret —
# there's no login and no API key; access to any given form/secret-request is the
# id+secret pair baked into its URL (optionally gated further by a PIN — see the skill's
# README, not this file).

APP_DOMAIN=dynaform.example.com
FORM_TTL_MINUTES=30

# Only relevant if you're deploying via deploy/compose.yml behind your own Traefik:
# CERT_RESOLVER=letsencrypt
# TRAEFIK_NETWORK=traf
